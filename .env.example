# Copy to .env next to docker-compose.yml (Compose Manager: "Edit Stack" -> "Env file").

# --- container ---
CCT_TAG=latest                 # or pin a release, e.g. 1.0.0
CCT_PORT=8000                  # host port for the web UI / API
CCT_DATA_DIR=/mnt/user/appdata/car-consumable-tracker
TZ=Europe/Amsterdam

# --- app ---
CCT_CURRENCY=EUR
CCT_API_TOKEN=                 # e.g. output of: openssl rand -hex 24
CCT_HA_WEBHOOK_URL=            # e.g. http://192.168.1.20:8123/api/webhook/car_consumable_tracker

# --- auto updates (Watchtower) ---
CCT_UPDATE_INTERVAL=3600       # seconds between update checks
# Only for a PRIVATE image – leave empty, the image is public:
GHCR_USER=                     # GitHub username
GHCR_TOKEN=                    # classic token with only the read:packages scope

# --- local development only ---
# CCT_DATABASE_URL=sqlite:///./data/cct.db
